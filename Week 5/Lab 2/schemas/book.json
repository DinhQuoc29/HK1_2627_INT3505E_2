{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book",
  "type": "object",
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 250},
    "isbn": {"type": ["string", "null"], "maxLength": 20},
    "price_vnd": {"type": "integer", "minimum": 0},
    "stock": {"type": "integer", "minimum": 0},
    "category_id": {"type": ["integer", "null"], "minimum": 1},
    "author_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
  },
  "required": ["title"],
  "additionalProperties": false
}
